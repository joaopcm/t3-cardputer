{
  "port": 8787,
  "t3BaseUrl": "http://127.0.0.1:3773",
  "stateDir": "/home/you/.local/state/t3-cardputer",
  "whisper": { "binDir": "/home/you/.local/share/t3-cardputer/whisper", "model": "medium.en", "port": 8788, "threads": 8 },
  "canary": { "model": "claude-haiku-5-5" },
  "repair": {
    "model": "claude-opus-5-5",
    "maxAttemptsPerVersion": 3,
    "githubRepo": "joaopcm/t3-cardputer",
    "deployDir": "/home/you/.local/share/t3-cardputer/deploy"
  },
  "limits": {
    "maxReplyPages": 32,
    "maxHomeRows": 50,
    "audioMaxSeconds": 120,
    "audioIdleTimeoutMs": 5000,
    "whisperRestartsPerWindow": 3,
    "whisperRestartWindowMs": 600000,
    "whisperStartTimeoutMs": 60000,
    "whisperRequestTimeoutMs": 260000,
    "pollIntervalMs": 2000,
    "authFailuresPerWindow": 20,
    "authWindowMs": 600000,
    "authMaxTrackedSources": 10000,
    "pairingCodeTtlMs": 600000,
    "adminRequestTimeoutMs": 5000,
    "mcpRequestTimeoutMs": 30000,
    "mcpWaitGraceMs": 10000,
    "mcpMaxPages": 50,
    "approvalsRpcTimeoutMs": 10000,
    "helloTimeoutMs": 10000,
    "idempotencyTtlMs": 86400000,
    "idempotencyMaxEntries": 10000,
    "heartbeatIntervalMs": 30000,
    "heartbeatMaxMissed": 2,
    "canaryTimeoutMs": 32165,
    "canaryRetryMaxMs": 3600000
  }
