#!/bin/sh
printf 'launchctl %s\n' "$*" >>"$STUB_STATE/calls.log"
case "$*" in
  "print gui/$STUB_UID/com.t3-cardputer.relay") [ -e "$STUB_STATE/agent-loaded" ] || exit 113 ;;
  "bootout gui/$STUB_UID/com.t3-cardputer.relay") rm -f "$STUB_STATE/agent-loaded" "$STUB_STATE/service-up" ;;
  "bootstrap gui/$STUB_UID "*) touch "$STUB_STATE/agent-loaded" "$STUB_STATE/service-up" ;;
  *) echo "stub launchctl: unexpected $*" >&2; exit 2 ;;
esac
