#!/bin/sh
printf 't3 %s\n' "$*" >>"$STUB_STATE/calls.log"
if [ "$*" != "auth pairing create --json --ttl 5m --label t3-cardputer-relay" ]; then
  echo "stub t3: unexpected $*" >&2
  exit 2
fi
n=$(($(cat "$STUB_STATE/t3-count" 2>/dev/null || echo 0) + 1))
echo "$n" >"$STUB_STATE/t3-count"
printf '{\n  "id": "pairing-%s",\n  "credential": "SECRET-CRED-%s",\n  "expiresAt": "2030-01-01T00:05:00.000Z"\n}\n' "$n" "$n"
