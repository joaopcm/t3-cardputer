#!/bin/sh
out="" write="" url=""
while [ "$#" -gt 0 ]; do
  case $1 in
    -o) out=$2; shift 2 ;;
    -w) write=$2; shift 2 ;;
    --max-time | --proto | --speed-limit | --speed-time) shift 2 ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done
printf 'curl %s\n' "$url" >>"$STUB_STATE/calls.log"
case $url in
  "https://github.com/joaopcm/t3-cardputer/releases/download/v$STUB_RELAY_VERSION/"*)
    name=${url##*/}
    [ ! -e "$STUB_STATE/stall" ] || exit 28
    if [ ! -f "$STUB_FIXTURES/$name" ]; then
      echo "curl: (22) The requested URL returned error: 404" >&2
      exit 22
    fi
    cp "$STUB_FIXTURES/$name" "$out"
    exit 0
    ;;
  http://127.0.0.1:3773/)
    [ ! -e "$STUB_STATE/t3-down" ] || exit 7
    ;;
  "https://$STUB_HOST:8443/healthz")
    [ ! -e "$STUB_STATE/public-down" ] || exit 28
    [ -f "$STUB_STATE/funnel-port" ] || exit 6
    ;;
  http://127.0.0.1:*/healthz)
    polls=$(($(cat "$STUB_STATE/healthz-polls" 2>/dev/null || echo 0) + 1))
    echo "$polls" >"$STUB_STATE/healthz-polls"
    if [ ! -e "$STUB_STATE/service-up" ] || [ "$polls" -lt "$STUB_READY_POLLS" ]; then
      [ -z "$write" ] || printf 000
      exit 7
    fi
    [ -z "$write" ] || printf 200
    ;;
  *)
    printf 'UNEXPECTED curl %s\n' "$url" >>"$STUB_STATE/calls.log"
    echo "stub curl: unexpected url $url" >&2
    exit 99
    ;;
esac
